// Redeploy trigger after runtime secrets were confirmed in Worker settings (2026-09-06 20:20 BRT)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "consulroriaamamenta-o",
  "main": "worker/domain-entry.js",
  "compatibility_date": "2026-09-06",
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    { "pattern": "deboralactacao.com", "custom_domain": true },
    { "pattern": "www.deboralactacao.com", "custom_domain": true },
    { "pattern": "app.deboralactacao.com", "custom_domain": true },
    { "pattern": "comercial.deboralactacao.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "17 4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "CLINICAL_DB",
      "database_name": "debora-lactacao-clinical",
      "database_id": "d9cdaf9e-87a6-47fc-afbc-1f6249fa4cbb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CLINICAL_FILES",
      "bucket_name": "debora-lactacao-clinical"
    }
  ],
  "services": [
    {
      "binding": "ARTISYS_LICENSING",
      "service": "obra-na-mao-comercial"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
