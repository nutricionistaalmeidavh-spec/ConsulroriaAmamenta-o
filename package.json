{
  "name": "html-static-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/materialize-clinical-source.mjs --write && node scripts/generate-pwa-icons.mjs && vite build",
    "preview": "vite preview",
    "test:auth-runtime": "node --test worker/domain-entry-response.test.mjs worker/cloudflare-auth-compat.test.mjs",
    "test:deploy-safety": "node scripts/test-production-deploy-contract.mjs",
    "test:seo": "node --test worker/seo-*.test.mjs && node scripts/test-public-seo.mjs && node scripts/test-commercial-mobile-first.mjs",
    "deploy:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cutover-cloudflare-runtime.ps1"
  },
  "dependencies": {
    "lucide": "^0.469.0",
    "fflate": "^0.8.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "sharp": "^0.34.3"
  }
}
